# Copy to /opt/apps/basaltemperatur/shared/.env.hostinger and keep mode 0600.
# Every empty name below must be set in production (NEXT_PUBLIC_GOOGLE_AUTH_ENABLED is optional).
APP_RUNTIME=hostinger
APP_PORT=3040
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_STREET=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
QA_PROBE_SECRET=
SEO_AUTOPILOT_APP_URL=
SEO_AUTOPILOT_INDEXNOW_KEY=
SEO_AUTOPILOT_POST_PATH_TEMPLATE=
SEO_AUTOPILOT_POSTS_SCHEMA=
SEO_AUTOPILOT_POSTS_TABLE=
SEO_AUTOPILOT_PUBLIC_BASE_URL=
SEO_AUTOPILOT_SECRET=
SEO_AUTOPILOT_SITE_ID=
SEO_AUTOPILOT_STORAGE_DRIVER=
SEO_AUTOPILOT_SUPABASE_ANON_KEY=
SEO_AUTOPILOT_SUPABASE_SERVICE_ROLE_KEY=
SEO_AUTOPILOT_SUPABASE_URL=
STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Required for the § 356a BGB withdrawal acknowledgement mail (lib/withdrawal-mail.ts).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Secret for hashing IPs in the consent-based traffic statistics; `openssl rand -hex 32`.
TRAFFIC_HASH_SALT=
# Set to true only after the Google provider is enabled in GoTrue.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
